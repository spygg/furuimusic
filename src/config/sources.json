  "customSourceContract": {
    "_note": "自定义音源用于替换 VIP / 不可播放的歌曲。只把你拥有合法授权的内容接入：自建 HTTP 服务或本地音乐目录。",
    "http": {
      "musicUrl": "GET {base}/musicUrl?name={name}&artist={artist}&album={album}&id={id}&source={source}&quality={quality}  -> {url, lyric, cover}",
      "search": "GET {base}/search?keyword={keyword}&limit={limit} -> {list:[{id,title,artist,album,cover,duration}]}",
      "lyric": "GET {base}/lyric?name={name}&artist={artist}&id={id} -> {lyric}"
    },
    "local": "扫描用户指定的本地目录，按歌名+歌手模糊匹配 mp3/flac/m4a/wav/ogg/aac 文件"
  },
  "userApiContract": {
    "_note": "自建账号 API 服务的统一契约；C++ 侧 http 驱动按此调用，实现参考 tools/account_api_server.py",
    "headers": {
      "X-Account-Cookie": "<cookie>"
    },
    "endpoints": {
      "verify": {
        "GET": "/user/verify?source=&cookie=",
        "返回": "{ok, profile:{uid,nickname,avatar}}"
      },
      "profile": {
        "GET": "/user/profile?source=&cookie=",
        "返回": "{ok, profile:{uid,nickname,avatar}}"
      },
      "playlists": {
        "GET": "/user/playlists?source=&cookie=&uid=&limit=&offset=",
        "返回": "{ok, playlists:[{id,title,cover,count,owner}]}"
      },
      "favorites": {
        "GET": "/user/favorites?source=&cookie=&uid=&limit=",
        "返回": "{ok, songs:[{id,title,artist,album,cover,duration}]}"
      },
      "playlistSongs": {
        "GET": "/user/playlistSongs?source=&cookie=&uid=&id=&limit=",
        "返回": "{ok, songs:[...]}"
      }
    }
  }
