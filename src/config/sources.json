    {
      "id": "qishui",
      "name": "汽水音乐",
      "color": "#12D4C6",
      "base": "https://api.qishui.com",
      "driver": "qishui",
      "enabled": true,
      "_note": "真实汽水（抖音旗下）端点直连（用户选的路线）。实测匿名搜索 /luna/pc/search/track 返回 HTTP 200 空响应，需登录态 Cookie（设置里填抖音/汽水 Cookie）才可能返回数据；X-Helios/X-Medusa 签名为可选 config，未内置。搜索/歌单详情返回是双层嵌套 result_groups[].data[].entity.track_wrapper.track（歌单详情为 media_resources[].entity.track_wrapper.track），框架通用 JsonMapper 不展平子数组，故在 MusicSource 加了 driver=\"qishui\" 做展平解析。播放/歌词走 /luna/h5/seo_track（Web UA + 可选 Cookie），返回 LRC + 播放变体，但 seo_track 可能是 H5/HTML，resultPaths 按常见字段 best-effort，命中即取、不命中回退跨源；若实测为 HTML 需后续加解析。字段映射依据 guowenye/qishui-api 的 normalizers.js。",
      "headers": {
        "User-Agent": "LunaPC/3.0.0(290101097)",
        "Referer": "https://www.qishui.com/",
        "Cookie": "{cookie}"
      },
      "endpoints": {
        "search": {
          "method": "GET",
          "path": "/luna/pc/search/track",
          "contentType": "json",
          "params": {
            "aid": "386088",
            "app_name": "luna_pc",
            "region": "cn",
            "geo_region": "cn",
            "os_region": "cn",
            "device_platform": "windows",
            "device_type": "Windows",
            "os_version": "Windows 11",
            "version_name": "3.0.0",
            "version_code": "30000000",
            "channel": "official",
            "build_mode": "master",
            "ac": "wifi",
            "tz_name": "Asia/Shanghai",
            "device_id": "00000000-0000-0000-0000-000000000000",
            "iid": "000000000000000",
            "fp": "00000000-0000-0000-0000-000000000000",
            "q": "{keyword}",
            "cursor": "{offset}"
          },
          "root": "result_groups",
          "fields": {
            "id": "data[].entity.track_wrapper.track.id",
            "title": "data[].entity.track_wrapper.track.name",
            "artist": "data[].entity.track_wrapper.track.artists[].name",
            "album": "data[].entity.track_wrapper.track.album.name",
            "cover": "data[].entity.track_wrapper.track.album.url_cover",
            "duration": "data[].entity.track_wrapper.track.duration",
            "durationScale": 1
          }
        },
        "playlistDetail": {
          "method": "POST",
          "path": "/luna/playlist/detail",
          "contentType": "json",
          "jsonBody": {
            "playlist_id": "{id}",
            "count": "{limit}"
          },
          "root": "media_resources",
          "fields": {
            "id": "entity.track_wrapper.track.id",
            "title": "entity.track_wrapper.track.name",
            "artist": "entity.track_wrapper.track.artists[].name",
            "album": "entity.track_wrapper.track.album.name",
            "cover": "entity.track_wrapper.track.album.url_cover",
            "duration": "entity.track_wrapper.track.duration",
            "durationScale": 1
          }
        },
        "url": {
          "method": "GET",
          "path": "/luna/h5/seo_track",
          "params": {
            "track_id": "{id}",
            "device_platform": "web"
          },
          "resultPaths": [
            "data.url",
            "url",
            "play_url",
            "audio.url",
            "data.play_url"
          ]
        },
        "lyric": {
          "method": "GET",
          "path": "/luna/h5/seo_track",
          "params": {
            "track_id": "{id}",
            "device_platform": "web"
          },
          "resultPaths": [
            "lyric",
            "lrc.lyric",
            "data.lyric"
          ]
        }
      },
      "login": {
        "methods": [
          "cookie"
        ],
        "_note": "仅 Cookie 登录为内置能力（填抖音/汽水登录态 Cookie）。汽水原生扫码登录需已登录抖音 App 扫码且涉及 X-Helios 签名，暂未内置。"
      },
      "userApi": {
        "driver": "",
        "base": "",
        "headers": {},
        "extraMethods": [],
        "_note": "汽水音乐的「我的歌单/收藏」需登录态且依赖签名，未配置。可部署自建账号 API 服务并在设置填写 accountApiBase 后自动接入（契约见 userApiContract）。"
      }
