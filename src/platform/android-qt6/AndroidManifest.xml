<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.furui.music"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <!-- 权限由 %%INSERT_PERMISSIONS 根据 Qt 模块依赖自动注入，避免重复声明 -->
    <!-- xlargeScreens：车机中控屏常被判定为 xlarge，缺这项时部分 ROM 会直接拒绝安装或锁死兼容模式 -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />
    <!-- resizeableActivity：分屏/自由形态的前提，不给就是「分屏时整块黑屏」而不是自适应 -->
    <!-- 应用内下载更新 APK 后拉起系统安装器（Android 8+ 必须声明） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 后台播放：前台服务保证退到后台/锁屏后进程不被回收；
         Android 14 起 mediaPlayback 类型必须配套 FOREGROUND_SERVICE_MEDIA_PLAYBACK，
         Android 13 起通知需要 POST_NOTIFICATIONS（运行时权限，启动时向用户申请） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:resizeableActivity="true"
        android:fullBackupOnly="false">
        <!-- 后台播放的关键开关：Qt for Android 默认把 android.app.background_running 当 false，
             会导出 QT_BLOCK_EVENT_LOOPS_WHEN_SUSPENDED=1 —— Activity 一进后台就冻结 Qt 事件
             循环。音频解码线程照旧出声，但 QTimer / 跨线程信号 / 网络回调全部停摆，实测表现
             就是「切到后台后播完一首不自动下一首」，回到前台才把攒下的信号一次性补跑。
             置 true 后事件循环在后台继续跑；Qt 在窗口不可见时本来就不渲染，无需额外处理。 -->
        <meta-data
            android:name="android.app.background_running"
            android:value="true" />
        <!-- configChanges 里没有 multiWindow 这一位（AAPT 实测直接报错，构建失败）：
             分屏/折叠的尺寸变化由 screenSize|smallestScreenSize|screenLayout|orientation|density
             这几位接住，Activity 不重建，播放状态与页面位置保住 -->
        <activity
            android:name="cn.furui.music.FuruiActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

          <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

          <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

          <!-- 后台不冻结事件循环（见上面 <application> 里的说明）。
               Qt 6.11 的 QtLoader 是按 ComponentInfo（ActivityInfo）读元数据的，
               只写在 <application> 下拿不到，实测 env 仍是 1；两处都写才稳妥。 -->
          <meta-data
                android:name="android.app.background_running"
                android:value="true" />
        </activity>

        <!-- 播放前台服务：常驻媒体通知 + MediaSession，供通知栏/锁屏/耳机/车机控制。
             exported=false：只由本进程启动，外部应用不能拉起 -->
        <service
            android:name="cn.furui.music.MediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 车机语音助手常把「下一首/上一首」转成 MEDIA_BUTTON 广播（而不是调用
             MediaSession transport controls）。没有它时仅在 App 前台才能响应语音。 -->
        <receiver
            android:name="cn.furui.music.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
    </application>
</manifest>
