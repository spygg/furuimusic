<?xml version="1.0"?>
<!-- 车机兼容版专用 manifest（仅测试用，不随主流版发布）。

     与 platform/android-qt6/AndroidManifest.xml 的差异：
       1) package="com.netease.cloudmusic.iot" —— 小迪语音白名单内的网易云车机版
          包名（语音助手 MediaUtil.f8201e 五项）：
            cn.kuwo.kwmusiccar / com.kugou.android.auto /
            com.ximalaya.ting.android.car / cmgyunting.vehicleplayer.cnr /
            com.netease.cloudmusic.iot
          选它要同时满足三道关卡，缺一不可：
            a) 白名单：FUNCTION_UPDATE 注册经 MusicAppReceiver 的 MediaUtil.o(pkg)
               校验，只有上表五项能写进默认音乐数据库；
            b) 分类：网易云车机版本就靠 FUNCTION_UPDATE（EXTRA_APPLICATION_TYPE=MUSIC）
               把本包名动态登记进 MUSIC 组，是被实车验证过的路径；央广云听空位
               cmgyunting.vehicleplayer.cnr 却被系统硬编码进 NEWS/RADIO 组，
               进不了「选择默认使用的音乐」弹窗，点歌始终走默认网易云；
            c) 语音词：MediaSearch.m11684c() 把「网易云 / 网易云音乐」硬编码映射成
               com.netease.cloudmusic.iot，说「打开网易云音乐」「播放晴天」才落到本应用。
          因此车机上必须先卸载官方网易云（同包名无法共存），再由本特供包占据 .iot。
          应用名保持「福瑞音乐」：车机设置里按包标签显示为福瑞音乐、可选为默认；
          语音关键词仍是「网易云音乐」——系统词库不含「福瑞音乐」，这一项改不了。
          曾用真实包名 cn.furui.music.car、伪装 com.netease.cloudmusic、央广云听空位，
          分别因白名单 / 分类 / 词库不匹配而失败。
       2) 新增 BydControlReceiver（老协议 34 个 action）与 BydMediaBridge.Receiver
          （新协议 AUTOVOICE_COMMON_* / AUTOVOICE_MEDIA_REGISTER）两个命令入口。

     其余内容（权限/Activity/Service/Provider/背景事件开关）必须与主流版
     manifest 保持一致，发现主流 manifest 有改动时同步过来。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.netease.cloudmusic.iot"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 9- 车机复制到公共 Download 需要写外部存储；API 29+ 走 MediaStore 不需要 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="28" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:resizeableActivity="true"
        android:fullBackupOnly="false">
        <meta-data
            android:name="android.app.background_running"
            android:value="true" />
        <activity
            android:name="cn.furui.music.FuruiActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

          <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

          <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

          <meta-data
                android:name="android.app.background_running"
                android:value="true" />
        </activity>

        <!-- 前台服务 + 可浏览媒体服务一体：车机媒体中心 connect 与
             「选择默认使用的音乐」列表过滤都依赖此 intent-filter -->
        <service
            android:name="cn.furui.music.MediaSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="cn.furui.music.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- BYD 小迪语音命令入口：与网易云车机版同款 34 个 action。
             priority 拉满保证车机发广播时我们先于其他组件收到。 -->
        <receiver
            android:name="cn.furui.music.BydControlReceiver"
            android:exported="true">
            <intent-filter android:priority="2147483646">
                <action android:name="com.byd.action.FUNCTION_UPDATE_RESULT" />
                <action android:name="byd.intent.action.MEDIA_BUTTON" />
                <action android:name="byd.intent.action.MEDIA_MODE" />
                <action android:name="com.byd.action.AUTOVOICE_SEARCH_PLUS" />
                <action android:name="com.byd.action.AUTOVOICE_COLLECT" />
                <action android:name="com.byd.action.AUTOVOICE_UNCOLLECT" />
                <action android:name="com.byd.action.AUTOVOICE_REWIND" />
                <action android:name="com.byd.action.AUTOVOICE_FORWARD" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_MODE" />
                <action android:name="com.byd.action.AUTOVOICE_OPEN_LIST" />
                <action android:name="com.byd.action.AUTOVOICE_CLOSE_LIST" />
                <action android:name="com.byd.action.AUTOVOICE_QUIT" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_LIKE" />
                <action android:name="com.byd.action.AUTOVOICE_RECOMMEND" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_FAVORITE" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_SONG_SHEET" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_LATELY" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_RANDOM" />
                <action android:name="com.byd.action.AUTOVOICE_BOOK" />
                <action android:name="com.byd.action.AUTOVOICE_UNBOOK" />
                <action android:name="com.byd.action.AUTOVOICE_OPEN_LYRIC" />
                <action android:name="com.byd.action.AUTOVOICE_CLOSE_LYRIC" />
                <action android:name="com.byd.action.AUTOVOICE_JUMP_TO" />
                <action android:name="com.byd.action.AUTOVOICE_FULL_SCREEN" />
                <action android:name="com.byd.action.AUTOVOICE_UNFULL_SCREEN" />
                <action android:name="com.byd.action.AUTOVOICE_SPEED_ADJUST" />
                <action android:name="com.byd.action.AUTOVOICE_SKIP_TITLE" />
                <action android:name="com.byd.action.AUTOVOICE_SKIP_END" />
                <action android:name="com.byd.action.AUTOVOICE_DOWNLOAD" />
                <action android:name="com.byd.action.AUTOVOICE_UNDOWNLOAD" />
                <action android:name="com.byd.action.AUTOVOICE_DEFINITION_SET" />
                <action android:name="com.byd.action.AUTOVOICE_QUALITY" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_BOOK" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_DOWNLOAD" />
            </intent-filter>
        </receiver>

        <!-- BYD 新语音协议（汽水车机版同款）：注册广播 + control/operation/query。
             该协议在部分车机版本不生效（汽水在这些车机上同样不被语音支持），
             仅作兜底；主力是 BydVoiceHelper 的老协议 FUNCTION_UPDATE 登记。 -->
        <receiver
            android:name="cn.furui.music.BydMediaBridge$Receiver"
            android:enabled="true"
            android:exported="true"
            android:priority="2147483646">
            <intent-filter>
                <action android:name="com.byd.action.AUTOVOICE_MEDIA_REGISTER" />
                <action android:name="com.byd.action.AUTOVOICE_COMMON_CONTROL" />
                <action android:name="com.byd.action.AUTOVOICE_COMMON_OPERATION" />
                <action android:name="com.byd.action.AUTOVOICE_COMMON_QUERY" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
    </application>
</manifest>
