# 构建输出（本地生成，不入库）
/build/
/build_check_*/
/build_output/
# 按工具链/Qt 版本分别做验证的构建目录（build-qt57 / build-qt515 / build-qt6 ...）
/build-qt*/
/debug/
/release/

# 可执行产物与打包产物（含 OpenSSL DLL、APK、临时探针）
/bin/
# 按 Qt 版本 / 平台划分的可分发产物目录（windeployqt 部署的 DLL、QML 插件、
# 签名 APK 都在这里，全部本地生成，不入库）
/bin_qt5/
/bin_qt6/
/bin_android/
*.exe
*.dll
# 例外：Release 包要带上的 OpenSSL 1.1 运行库（见 src/packaging/windows/openssl/README.txt）
!src/packaging/windows/openssl/*.dll
*.so
# 例外：Android Qt 6 APK 打包必需的 OpenSSL 3 运行库（共约 4.6M，缺了 APK 的 HTTPS 全部失效）
!src/android_qt6/libs/arm64-v8a/libssl_3.so
!src/android_qt6/libs/arm64-v8a/libcrypto_3.so
*.dylib
*.a
*.lib
*.apk
*.aar
*.o
*.obj
*.moc
moc_*.cpp
ui_*.h
qrc_*.cpp

# 第三方参考源码副本（仅本地研究用，含 AGPL 项目，不入库）
/reference/
# 多平台 Release 配置的本地参考副本（同 reference/，不入库）
/.github参考/

# 第三方源码：Qt 5 播放后端的 FFmpeg n6.1.2 随仓库分发（CMake 自动编译要用）。
# 以下都是 QtRemoteDesktop 屏幕编码链的遗留源码/预编译产物，播放用不到且体积大，不入库。
/src/thirdparty/ffmpeg/FFmpeg-n3.4.8/
/src/thirdparty/ffmpeg/amf-sdk-1.5.3/
/src/thirdparty/ffmpeg/nv-codec-headers-n12.2.72.0/
/src/thirdparty/ffmpeg/oneVPL-2.17.0/
/src/thirdparty/ffmpeg/install/
# FFmpeg 构建中间产物（源码树内原地 configure 时才会出现）
/src/thirdparty/ffmpeg/FFmpeg-n6.1.2/ffbuild/config.mak
/src/thirdparty/ffmpeg/FFmpeg-n6.1.2/config.h

# 本地临时目录 / 助手状态 / 截图草稿
/.scratch_jsprobe/
/.workbuddy/
/.screenshots/

# 数据库与登录态（含 Cookie / MUSIC_U，绝不入库）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db3
furui.db*

# 日志与诊断输出
*.log
http_diag.log
scan*.log

# 本地设置与 IDE / 系统文件
*.user
*.autosave
*.pro.user
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db
desktop.ini

# 本地排障用的截图/探针产物
/.probe/
